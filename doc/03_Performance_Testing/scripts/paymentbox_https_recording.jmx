<?xml version="1.0" encoding="UTF-8"?>
<!--
  PaymentBox Telco Operator — Performance Test (HTTPS Recording)
  ==============================================================
  Script generado mediante grabación en protocolo HTTPS.
  Incluye todas las APIs del flujo E2E de 8 pasos con headers,
  bodies y parametrización de datos variables.

  Herramienta : Apache JMeter 5.x
  Protocolo   : HTTPS (TLS 1.2/1.3)
  Flujo       : Auth → Focalizar Cliente → Montos → Validar Operador
                → Métodos Pago → Registrar Pago → Emitir Recibo
  Datos       : CSV parametrizado (datos_usuarios.csv)

  Ejecución local:
    jmeter -n -t paymentbox_https_recording.jmx \
           -Jbase_url=localhost \
           -Jbase_port=8443 \
           -l results/resultado_$(date +%Y%m%d_%H%M%S).jtl \
           -e -o results/report/

  Variables de entorno soportadas (parámetros -J):
    base_url      : host del servidor  (default: localhost)
    base_port     : puerto HTTPS       (default: 8443)
    auth_url      : host auth server   (default: localhost)
    auth_port     : puerto auth server (default: 9443)
    thread_count  : número de usuarios virtuales (default: 20)
    ramp_up       : ramp-up en segundos          (default: 60)
    duration      : duración del test en segundos (default: 420)
    csv_file      : ruta al CSV de usuarios       (default: datos_usuarios.csv)
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  TEST PLAN                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan"
              testname="PaymentBox HTTPS — Performance Test (Grabacion)"
              enabled="true">
      <stringProp name="TestPlan.comments">
        Script de performance generado mediante grabación HTTPS.
        Flujo completo E2E PaymentBox Telco Operator — AT&amp;T PoC.
      </stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>

      <!-- Variables globales parametrizables -->
      <elementProp name="TestPlan.user_defined_variables"
                   elementType="Arguments"
                   guiclass="ArgumentsPanel">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">${__P(base_url,localhost)}</stringProp>
          </elementProp>
          <elementProp name="BASE_PORT" elementType="Argument">
            <stringProp name="Argument.name">BASE_PORT</stringProp>
            <stringProp name="Argument.value">${__P(base_port,8443)}</stringProp>
          </elementProp>
          <elementProp name="AUTH_URL" elementType="Argument">
            <stringProp name="Argument.name">AUTH_URL</stringProp>
            <stringProp name="Argument.value">${__P(auth_url,localhost)}</stringProp>
          </elementProp>
          <elementProp name="AUTH_PORT" elementType="Argument">
            <stringProp name="Argument.name">AUTH_PORT</stringProp>
            <stringProp name="Argument.value">${__P(auth_port,9443)}</stringProp>
          </elementProp>
          <elementProp name="THREAD_COUNT" elementType="Argument">
            <stringProp name="Argument.name">THREAD_COUNT</stringProp>
            <!-- Load test default: 2000 VUs. Smoke: -Jthread_count=20 -->
            <stringProp name="Argument.value">${__P(thread_count,2000)}</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP</stringProp>
            <!-- Ramp-up: 300s (5 min) para 2000 VUs. Smoke: -Jramp_up=60 -->
            <stringProp name="Argument.value">${__P(ramp_up,300)}</stringProp>
          </elementProp>
          <elementProp name="DURATION" elementType="Argument">
            <stringProp name="Argument.name">DURATION</stringProp>
            <!-- Load test: 3600s (1h). Smoke: -Jduration=420 -->
            <stringProp name="Argument.value">${__P(duration,3600)}</stringProp>
          </elementProp>
          <elementProp name="CSV_FILE" elementType="Argument">
            <stringProp name="Argument.name">CSV_FILE</stringProp>
            <stringProp name="Argument.value">${__P(csv_file,datos_usuarios.csv)}</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!--  HTTP REQUEST DEFAULTS — HTTPS global                              -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement"
                         testname="HTTP Request Defaults — HTTPS"
                         enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments"/>
        <stringProp name="HTTPSampler.domain">${BASE_URL}</stringProp>
        <stringProp name="HTTPSampler.port">${BASE_PORT}</stringProp>
        <stringProp name="HTTPSampler.protocol">https</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
        <!-- Load test: 20s timeout (vs 10s smoke). Bajo carga 2k VUs se esperan tiempos más altos -->
        <stringProp name="HTTPSampler.response_timeout">20000</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!--  SSL / TLS — Aceptar certificados del servidor (entorno de pruebas) -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments"
                 testname="SSL — Variables TLS"
                 enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="https.use.cached.ssl.context" elementType="Argument">
            <stringProp name="Argument.name">https.use.cached.ssl.context</stringProp>
            <stringProp name="Argument.value">false</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!--  COOKIE MANAGER                                                     -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <CookieManager guiclass="CookiePanel" testclass="CookieManager"
                     testname="HTTP Cookie Manager"
                     enabled="true">
        <boolProp name="CookieManager.clearEachIteration">true</boolProp>
        <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
      </CookieManager>
      <hashTree/>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!--  CACHE MANAGER                                                      -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <CacheManager guiclass="CacheManagerGui" testclass="CacheManager"
                    testname="HTTP Cache Manager"
                    enabled="true">
        <boolProp name="clearEachIteration">true</boolProp>
        <boolProp name="useExpires">true</boolProp>
        <intProp name="maxSize">5000</intProp>
      </CacheManager>
      <hashTree/>

      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <!--  THREAD GROUP — Flujo E2E PaymentBox (HTTPS)                       -->
      <!-- ═══════════════════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup"
                   testname="PaymentBox E2E — Flujo HTTPS Grabado"
                   enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller"
                     elementType="LoopController"
                     guiclass="LoopControlGui">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${THREAD_COUNT}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_UP}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${DURATION}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
      </ThreadGroup>
      <hashTree>

        <!-- ─────────────────────────────────────────────────────────────── -->
        <!--  CSV DATA SET — Parametrización de usuarios                     -->
        <!-- ─────────────────────────────────────────────────────────────── -->
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet"
                    testname="CSV — Datos de Usuarios Parametrizados"
                    enabled="true">
          <stringProp name="filename">${CSV_FILE}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">user_id,telefono,nombre,operador,monto,metodoPago,authUser,authPass</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree/>

        <!-- ─────────────────────────────────────────────────────────────── -->
        <!--  HEADER MANAGER GLOBAL — Headers comunes HTTPS                  -->
        <!-- ─────────────────────────────────────────────────────────────── -->
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                       testname="Headers Globales HTTPS"
                       enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Accept-Encoding</stringProp>
              <stringProp name="Header.value">gzip, deflate, br</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Connection</stringProp>
              <stringProp name="Header.value">keep-alive</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>

        <!-- ─────────────────────────────────────────────────────────────── -->
        <!--  CONTADOR — numeroOrden único por iteración                     -->
        <!-- ─────────────────────────────────────────────────────────────── -->
        <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig"
                       testname="Contador — numeroOrden"
                       enabled="true">
          <stringProp name="CounterConfig.start">1</stringProp>
          <stringProp name="CounterConfig.end">999999</stringProp>
          <stringProp name="CounterConfig.incr">1</stringProp>
          <stringProp name="CounterConfig.name">order_counter</stringProp>
          <stringProp name="CounterConfig.format">000000</stringProp>
          <boolProp name="CounterConfig.per_user">true</boolProp>
        </CounterConfig>
        <hashTree/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!--  PASO 1 — Autenticación OAuth2 (HTTPS)                           -->
        <!--  POST https://${AUTH_URL}:${AUTH_PORT}/auth/login                -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="Paso 1 — Autenticacion HTTPS"
                               enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>

          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="POST /auth/login"
                            enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{
  "username": "${authUser}",
  "password": "${authPass}"
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${AUTH_URL}</stringProp>
            <stringProp name="HTTPSampler.port">${AUTH_PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/auth/login</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <!-- Extractor: access_token -->
            <JSONPathExtractor guiclass="JSONPathExtractorGui"
                               testclass="JSONPathExtractor"
                               testname="Extraer access_token"
                               enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">access_token</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExpr">$.access_token</stringProp>
              <stringProp name="JSONPathExtractor.defaultValue">TOKEN_NO_ENCONTRADO</stringProp>
              <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            </JSONPathExtractor>
            <hashTree/>
            <!-- Extractor: refresh_token -->
            <JSONPathExtractor guiclass="JSONPathExtractorGui"
                               testclass="JSONPathExtractor"
                               testname="Extraer refresh_token"
                               enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">refresh_token</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExpr">$.refresh_token</stringProp>
              <stringProp name="JSONPathExtractor.defaultValue">REFRESH_NO_ENCONTRADO</stringProp>
              <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            </JSONPathExtractor>
            <hashTree/>
            <!-- Assertion: token obtenido -->
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert — status 200 y token presente"
                               enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Login fallido — esperado HTTP 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui"
                               testclass="JSONPathAssertion"
                               testname="Assert — access_token presente"
                               enabled="true">
              <stringProp name="JSON_PATH">$.access_token</stringProp>
              <stringProp name="EXPECTED_VALUE"></stringProp>
              <boolProp name="JSONVALIDATION">false</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <!-- Timer entre pasos -->
        <UniformRandomTimer guiclass="UniformRandomTimerGui"
                            testclass="UniformRandomTimer"
                            testname="Think Time 1-3s"
                            enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
          <stringProp name="RandomTimer.range">2000</stringProp>
        </UniformRandomTimer>
        <hashTree/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!--  HEADER MANAGER CON TOKEN — Aplica a todos los pasos siguientes  -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                       testname="Header — Authorization Bearer Token"
                       enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${access_token}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!--  PASO 2 — Focalizar Cliente                                      -->
        <!--  GET https://host/api/clientes/buscar?telefono=XXXX              -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="Paso 2 — Focalizar Cliente (HTTPS)"
                               enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="GET /api/clientes/buscar"
                            enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="telefono" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">telefono</stringProp>
                  <stringProp name="Argument.value">${telefono}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/clientes/buscar</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <!-- Extractor: clienteId para pasos posteriores -->
            <JSONPathExtractor guiclass="JSONPathExtractorGui"
                               testclass="JSONPathExtractor"
                               testname="Extraer clienteId"
                               enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">clienteId</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExpr">$.id</stringProp>
              <stringProp name="JSONPathExtractor.defaultValue">CLIENTE_NO_ENCONTRADO</stringProp>
              <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            </JSONPathExtractor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert — status 200"
                               enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui"
                               testclass="JSONPathAssertion"
                               testname="Assert — cliente ACTIVO"
                               enabled="true">
              <stringProp name="JSON_PATH">$.status</stringProp>
              <stringProp name="EXPECTED_VALUE">ACTIVO</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <UniformRandomTimer guiclass="UniformRandomTimerGui"
                            testclass="UniformRandomTimer"
                            testname="Think Time 1-3s"
                            enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
          <stringProp name="RandomTimer.range">2000</stringProp>
        </UniformRandomTimer>
        <hashTree/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!--  PASO 3 — Consultar Montos DB                                    -->
        <!--  GET https://host/api/recargas/montos?operador=XXXX              -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="Paso 3 — Consultar Montos DB (HTTPS)"
                               enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="GET /api/recargas/montos"
                            enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="operador" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">operador</stringProp>
                  <stringProp name="Argument.value">${operador}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/recargas/montos</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert — status 200"
                               enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui"
                               testclass="JSONPathAssertion"
                               testname="Assert — al menos 1 monto"
                               enabled="true">
              <stringProp name="JSON_PATH">$[0]</stringProp>
              <stringProp name="EXPECTED_VALUE"></stringProp>
              <boolProp name="JSONVALIDATION">false</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <UniformRandomTimer guiclass="UniformRandomTimerGui"
                            testclass="UniformRandomTimer"
                            testname="Think Time 1-3s"
                            enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
          <stringProp name="RandomTimer.range">2000</stringProp>
        </UniformRandomTimer>
        <hashTree/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!--  PASO 4 — Validar Operador                                       -->
        <!--  POST https://host/api/recargas/validar-operador?...             -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="Paso 4 — Validar Operador (HTTPS)"
                               enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="POST /api/recargas/validar-operador"
                            enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="telefono" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">telefono</stringProp>
                  <stringProp name="Argument.value">${telefono}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
                <elementProp name="operador" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.name">operador</stringProp>
                  <stringProp name="Argument.value">${operador}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/recargas/validar-operador</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert — status 200"
                               enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui"
                               testclass="JSONPathAssertion"
                               testname="Assert — valido true"
                               enabled="true">
              <stringProp name="JSON_PATH">$.valido</stringProp>
              <stringProp name="EXPECTED_VALUE">true</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <UniformRandomTimer guiclass="UniformRandomTimerGui"
                            testclass="UniformRandomTimer"
                            testname="Think Time 1-3s"
                            enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
          <stringProp name="RandomTimer.range">2000</stringProp>
        </UniformRandomTimer>
        <hashTree/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!--  PASO 5 — Métodos de Pago PaymentBox                             -->
        <!--  GET https://host/api/pagos/metodos                              -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="Paso 5 — Metodos de Pago (HTTPS)"
                               enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="GET /api/pagos/metodos"
                            enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments"/>
            <stringProp name="HTTPSampler.path">/api/pagos/metodos</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert — status 200"
                               enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert — contiene EFECTIVO"
                               enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="1">EFECTIVO</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <UniformRandomTimer guiclass="UniformRandomTimerGui"
                            testclass="UniformRandomTimer"
                            testname="Think Time 1-3s"
                            enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
          <stringProp name="RandomTimer.range">2000</stringProp>
        </UniformRandomTimer>
        <hashTree/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!--  PASOS 6+7 — Registrar Pago                                      -->
        <!--  POST https://host/api/pagos/registrar                           -->
        <!--  Body: { telefonoCliente, monto, metodoPago, numeroOrden }        -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="Pasos 6+7 — Registrar Pago (HTTPS)"
                               enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="POST /api/pagos/registrar"
                            enabled="true">
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{
  "telefonoCliente": "${telefono}",
  "monto": ${monto},
  "metodoPago": "${metodoPago}",
  "numeroOrden": "ORD-${__threadNum}-${order_counter}"
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">/api/pagos/registrar</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <!-- Extractor: folio para emitir recibo -->
            <JSONPathExtractor guiclass="JSONPathExtractorGui"
                               testclass="JSONPathExtractor"
                               testname="Extraer folio"
                               enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">folio</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExpr">$.folio</stringProp>
              <stringProp name="JSONPathExtractor.defaultValue">FOLIO_NO_GENERADO</stringProp>
              <stringProp name="JSONPathExtractor.match_no">0</stringProp>
            </JSONPathExtractor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert — status 201"
                               enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49587">201</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui"
                               testclass="JSONPathAssertion"
                               testname="Assert — status APLICADO"
                               enabled="true">
              <stringProp name="JSON_PATH">$.status</stringProp>
              <stringProp name="EXPECTED_VALUE">APLICADO</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui"
                               testclass="JSONPathAssertion"
                               testname="Assert — folio prefijo B-"
                               enabled="true">
              <stringProp name="JSON_PATH">$.folio</stringProp>
              <stringProp name="EXPECTED_VALUE">B-.*</stringProp>
              <boolProp name="JSONVALIDATION">true</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">true</boolProp>
            </JSONPathAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>

        <UniformRandomTimer guiclass="UniformRandomTimerGui"
                            testclass="UniformRandomTimer"
                            testname="Think Time 1-3s"
                            enabled="true">
          <stringProp name="ConstantTimer.delay">1000</stringProp>
          <stringProp name="RandomTimer.range">2000</stringProp>
        </UniformRandomTimer>
        <hashTree/>

        <!-- ═════════════════════════════════════════════════════════════════ -->
        <!--  PASO 8 — Emitir Recibo                                          -->
        <!--  POST https://host/api/recibos/emitir?folio=X&numeroOrden=Y      -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="Paso 8 — Emitir Recibo (HTTPS)"
                               enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController"
                        testname="Si folio fue generado"
                        enabled="true">
            <stringProp name="IfController.condition">"${folio}" != "FOLIO_NO_GENERADO"</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">false</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                              testname="POST /api/recibos/emitir"
                              enabled="true">
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="folio" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">true</boolProp>
                    <stringProp name="Argument.name">folio</stringProp>
                    <stringProp name="Argument.value">${folio}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                  <elementProp name="numeroOrden" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">true</boolProp>
                    <stringProp name="Argument.name">numeroOrden</stringProp>
                    <stringProp name="Argument.value">ORD-${__threadNum}-${order_counter}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <stringProp name="HTTPSampler.path">/api/recibos/emitir</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                                 testname="Assert — status 200"
                                 enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="49586">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSONPathAssertion guiclass="JSONPathAssertionGui"
                                 testclass="JSONPathAssertion"
                                 testname="Assert — status EMITIDO"
                                 enabled="true">
                <stringProp name="JSON_PATH">$.status</stringProp>
                <stringProp name="EXPECTED_VALUE">EMITIDO</stringProp>
                <boolProp name="JSONVALIDATION">true</boolProp>
                <boolProp name="EXPECT_NULL">false</boolProp>
                <boolProp name="INVERT">false</boolProp>
                <boolProp name="ISREGEX">false</boolProp>
              </JSONPathAssertion>
              <hashTree/>
              <JSONPathAssertion guiclass="JSONPathAssertionGui"
                                 testclass="JSONPathAssertion"
                                 testname="Assert — url_pdf presente"
                                 enabled="true">
                <stringProp name="JSON_PATH">$.url_pdf</stringProp>
                <stringProp name="EXPECTED_VALUE"></stringProp>
                <boolProp name="JSONVALIDATION">false</boolProp>
                <boolProp name="EXPECT_NULL">false</boolProp>
                <boolProp name="INVERT">false</boolProp>
                <boolProp name="ISREGEX">false</boolProp>
              </JSONPathAssertion>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>

        <!-- ═════════════════════════════════════════════════════════════════ -->
